#include <winuser.h>
#include <winver.h>
#include "aln_version.h"

1 ICON "../packaging/icons/app-icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "alienation.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ALN_VERSION_NUMBERS
PRODUCTVERSION ALN_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "saulob"
            VALUE "FileDescription", "Alienation PC"
            VALUE "FileVersion", ALN_FILE_VERSION_STRING
            VALUE "InternalName", "alienation"
            VALUE "OriginalFilename", "alienation.exe"
            VALUE "ProductName", "Alienation PC"
            VALUE "ProductVersion", ALN_VERSION_STRING
            VALUE "Comments", "https://github.com/saulob/alienation-pc"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
